{
  "name": "boostman",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:local": "node scripts/build-local.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "node --test tests/*.test.mjs && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "check": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml",
    "format": "prettier --write src src-tauri/src/scripts.js && cargo fmt --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@xyflow/react": "^12.12.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  }
}
